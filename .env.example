# Copy this file to .env and add a restricted ElevenLabs API key.
ELEVENLABS_API_KEY=
# Optional override; defaults to the demo agent below.
ELEVENLABS_AGENT_ID=agent_1101m2b4acdnedz9y2yky3w9vwfm
# HMAC secret generated when the ElevenLabs post-call webhook is created.
ELEVENLABS_WEBHOOK_SECRET=
# Public HTTPS origin required for phone-call policy webhooks, for example an ngrok URL.
PUBLIC_BASE_URL=
# Optional bearer key for /tool/* in a hosted deployment. Leave empty for the local browser demo.
TOOL_API_KEY=
# SQLite is the default. Override only when a different local file is needed.
DATABASE_URL=sqlite://data/jellyphish.db
# Local listen address.
BIND_ADDR=127.0.0.1:4173
# Shared HMAC secret used by the telephony-to-dashboard sidecar webhook.
MONITOR_WEBHOOK_SECRET=
# Real teammate destination in E.164 format, used only after a Twilio or SIP inbound number is assigned.
HUMAN_TRANSFER_NUMBER=
